            "metadata": {
              "inputs": [],
              "type": "Extension/HubsExtension/PartType/MarkdownPart",
              "settings": {
                "content": {
                  "content": "Azure Functions API (Python) storing access reviews in Azure Table Storage.\n\nSecrets live in Key Vault and are read with managed identity.\nA daily Logic App calls `PATCH /access-reviews/validate` and emails the result.\n\nRule: status = active and expirationDate < today → status = expired, needsRevocation = true",
                  "title": "Access Review Delegation Tracker",
                  "subtitle": "Final project · Ty Iorfino",
                  "markdownSource": 1,
                  "markdownUri": ""
                }
              }
            }
          },
          {
            "position": {
              "x": 11,
              "y": 0,
              "colSpan": 10,
              "rowSpan": 2
            },
            "metadata": {
              "inputs": [
                {
                  "name": "resourceTypeMode",
                  "isOptional": true
                },
                {
                  "name": "ComponentId",
                  "isOptional": true
                },
                {
                  "name": "Scope",
                  "value": {
                    "resourceIds": [
                      "/subscriptions/494efe8a-12f8-47e4-93d9-92ab9b44a3c3/resourcegroups/rg-accessreview-dev-eus2-001/providers/microsoft.operationalinsights/workspaces/workspace-appi-accessreview-dev-eus2-001"
                    ]
                  },
                  "isOptional": true
                },
                {
                  "name": "PartId",
                  "value": "c097de10-11dc-48d7-8ed7-79469c7598d1",
                  "isOptional": true
                },
                {
                  "name": "Version",
                  "value": "2.0",
                  "isOptional": true
                },
                {
                  "name": "TimeRange",
                  "isOptional": true
                },
                {
                  "name": "DashboardId",
                  "isOptional": true
                },
                {
                  "name": "DraftRequestParameters",
                  "isOptional": true
                },
                {
                  "name": "Query",
                  "value": "let req = AppRequests | where TimeGenerated > ago(7d);\nlet val = AppEvents | where TimeGenerated > ago(7d) and Name == \"ValidationCompleted\";\nlet la  = AzureDiagnostics | where TimeGenerated > ago(7d)\n          and ResourceProvider == \"MICROSOFT.LOGIC\" and OperationName endswith \"workflowRunCompleted\";\nprint\n  ApiRequests      = toscalar(req | count),\n  ApiSuccessRate   = strcat(round(100.0 * toscalar(req | where Success == true | count) / toscalar(req | count), 1), \"%\"),\n  ValidationRuns   = toscalar(val | count),\n  AccessFlagged    = toscalar(val | summarize sum(toint(Properties.updatedCount))),\n  LogicAppRuns     = toscalar(la | count),\n  LogicAppFailures = toscalar(la | where status_s == \"Failed\" | count)\n",
                  "isOptional": true
                },
                {
                  "name": "ControlType",
                  "value": "AnalyticsGrid",
                  "isOptional": true
                },
                {
                  "name": "SpecificChart",
                  "isOptional": true
                },
                {
                  "name": "PartTitle",
                  "value": "Log Analytics",
                  "isOptional": true
                },
                {
                  "name": "PartSubTitle",
                  "value": "workspace-appi-accessreview-dev-eus2-001",
                  "isOptional": true
                },
                {
                  "name": "Dimensions",
                  "isOptional": true
                },
                {
                  "name": "LegendOptions",
                  "isOptional": true
                },
                {
                  "name": "IsQueryContainTimeRange",
                  "value": true,
                  "isOptional": true
                }
              ],
