                        "connectionId": "/subscriptions/494efe8a-12f8-47e4-93d9-92ab9b44a3c3/resourceGroups/rg-accessreview-dev-eus2-001/providers/Microsoft.Web/connections/outlook",
                        "connectionName": "outlook",
